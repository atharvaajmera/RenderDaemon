Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Go ignores (Backend)
backend/temp/
backend/.gocache/
backend/.env
backend/go.work
backend/go.work.sum
backend/vendor/
*.test
*.out
*.prof

# Next.js ignores (Frontend)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env*.local
frontend/.vercel
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Root documentation and plans
render-queue.md
walkthrough.md
